#!/bin/sh
# Format, lint and test what is staged, so the hook stays fast.
# Enable once per clone with: git config core.hooksPath .githooks
set -e
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
[ -z "$files" ] && exit 0
packages=$(for f in $files; do dirname "$f"; done | sort -u | sed 's|^|./|')

echo "pre-commit: format"
unformatted=$(gofmt -l $files)
if [ -n "$unformatted" ]; then
  echo "run gofmt -w on:" >&2
  echo "$unformatted" >&2
  exit 1
fi

echo "pre-commit: lint"
go vet $packages
if command -v staticcheck >/dev/null 2>&1; then
  staticcheck $packages
fi

echo "pre-commit: test"
go test -count=1 $packages
