#!/bin/sh
# Format, lint and test the whole module, so nothing reaches the remote unchecked.
set -e

echo "pre-push: format"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "run gofmt -w on:" >&2
  echo "$unformatted" >&2
  exit 1
fi

echo "pre-push: lint"
go vet ./...
if command -v staticcheck >/dev/null 2>&1; then
  staticcheck ./...
fi

echo "pre-push: test"
go test -count=1 ./...
