# Dev mode enables plain HTTP on loopback and the faux chain. Never set it on a reachable host.
FORYOU_DEV=1

# Certificates are used only when FORYOU_DEV is unset; dev mode always serves plain HTTP on loopback.
# FORYOU_TLS_CERT=
# FORYOU_TLS_KEY=

# Base directory for role data (each role uses a subdirectory).
# FORYOU_DATA_DIR=.local/data

# Default loopback listen addresses.
# FORYOU_CLIENT_ADDR=127.0.0.1:8443
# FORYOU_FOUNDATION_ADDR=127.0.0.1:8444
# FORYOU_PROVIDER_ADDR=127.0.0.1:8445
# FORYOU_REPLICA_ADDR=127.0.0.1:8446
# FORYOU_MONITOR_ADDR=127.0.0.1:8447
# FORYOU_FAUX_ADDR=127.0.0.1:8448

# Default base URLs used by other roles.
# FORYOU_CLIENT_URL=http://127.0.0.1:8443
# FORYOU_FOUNDATION_URL=http://127.0.0.1:8444
# FORYOU_PROVIDER_URL=http://127.0.0.1:8445
# FORYOU_REPLICA_URL=http://127.0.0.1:8446
# FORYOU_MONITOR_URL=http://127.0.0.1:8447
# FORYOU_FAUX_URL=http://127.0.0.1:8448

# Public HTTPS origin used in post and embed links.
# FORYOU_PUBLIC_ORIGIN=https://127.0.0.1:8443
