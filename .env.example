# Copy to .env and set local-only values. Process environment takes precedence.
FORYOU_TLS_CERT=.local/localhost.crt
FORYOU_TLS_KEY=.local/localhost.key
# Public HTTPS origin used in post and embed links. The default is local only.
# FORYOU_PUBLIC_ORIGIN=https://127.0.0.1:8443

# Defaults: 127.0.0.1:8443 through 8446, respectively.
# FORYOU_CLIENT_ADDR=127.0.0.1:8443
# FORYOU_FOUNDATION_ADDR=127.0.0.1:8444
# FORYOU_PROVIDER_ADDR=127.0.0.1:8445
# FORYOU_REPLICA_ADDR=127.0.0.1:8446

# Configure a PostgreSQL URL separately for each role. Leave empty to run the
# HTTP demo with /readyz reporting that the database is not configured.
FORYOU_CLIENT_DATABASE_URL=
FORYOU_FOUNDATION_DATABASE_URL=
FORYOU_PROVIDER_DATABASE_URL=
FORYOU_REPLICA_DATABASE_URL=
